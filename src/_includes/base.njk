<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ metaTitle or title }} | {{ site.title }}</title>
<meta name="description" content="{{ metaDescription or site.footerBlurb }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/style.css">
</head>
<body>

<div class="announce">{{ site.announce }}</div>

<header class="site-header">
  <div class="nav-wrap">
    <a href="/" class="brand"><b>{{ site.brandPrefix }}</b> {{ site.brandName }}</a>
    <button class="burger" onclick="toggleNav()" aria-label="Menu"><span></span><span></span><span></span></button>
    <ul class="nav-menu" id="navMenu">
      <li><a href="/about/"{% if nav == 'about' %} class="current"{% endif %}>About</a></li>
      <li><a href="/treatments/"{% if nav == 'treatments' %} class="current"{% endif %}>Treatments</a></li>
      <li><a href="/news/"{% if nav == 'news' %} class="current"{% endif %}>News</a></li>
      <li><a href="/book/" class="nav-cta">Book a Treatment</a></li>
    </ul>
  </div>
</header>

{{ content | safe }}

<section class="cta-band">
  <div class="container">
    <p class="eyebrow" style="color:rgba(255,255,255,0.8);">{{ cta.eyebrow }}</p>
    <h2>{{ cta.headingA }}<br /><em style="color:#F7F0E6;">{{ cta.headingB }}</em></h2>
    <p>{{ cta.body }}</p>
    <div class="btn-row">
      <a href="{{ cta.primaryUrl }}" class="btn btn-primary">{{ cta.primaryLabel }}</a>
    </div>
    <p class="cta-closing">{{ cta.closing }}</p>
  </div>
</section>

<footer class="site-footer">
  <div class="container">
    <div class="foot-grid-3">
      <div>
        <p class="foot-brand"><b>{{ site.brandPrefix }}</b> {{ site.brandName }}</p>
        <p class="foot-blurb">{{ site.footerBlurb }}</p>
      </div>
      <div class="foot-col">
        <h5>Explore</h5>
        <ul>
          <li><a href="/about/">About &amp; Our Story</a></li>
          <li><a href="/treatments/">Treatments</a></li>
          <li><a href="/news/">News &amp; Updates</a></li>
          <li><a href="/book/">Book a Treatment</a></li>
          <li><a href="/book/#faq">Frequently Asked</a></li>
        </ul>
      </div>
      <div class="foot-col">
        <h5>Get in Touch</h5>
        <ul>
          <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
          <li><a href="{{ site.instagramUrl }}">{{ site.instagram }}</a></li>
          <li><span class="foot-plain">{{ site.hours }}</span></li>
          <li><span class="foot-plain">{{ site.location }}</span></li>
        </ul>
      </div>
    </div>
    <div class="foot-bottom">
      <span>&copy; {{ site.copyright }}</span>
      <span>{{ site.disclaimer }}</span>
    </div>
  </div>
</footer>

<script>
function toggleNav(){ document.getElementById('navMenu').classList.toggle('open'); }
document.querySelectorAll('.faq-q').forEach(function(b){
  b.addEventListener('click', function(){ b.parentElement.classList.toggle('open'); });
});
</script>
</body>
</html>
