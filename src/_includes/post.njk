---
layout: base.njk
nav: news
---
<section class="page-hero">
  <div class="orb orb-a"></div><div class="orb orb-b"></div>
  <div class="container">
    <p class="crumb"><a href="/">Home</a> &nbsp;/&nbsp; <a href="/news/">News</a></p>
    <p class="eyebrow">{{ date | niceDate }}</p>
    <h1 style="color:#FDFAF6;">{{ title }}</h1>
    {% if summary %}<p>{{ summary }}</p>{% endif %}
  </div>
</section>

<section class="bg-white">
  <div class="container-narrow">
    {% if image %}<div class="post-img" style="background-image:url('{{ image }}');"></div>{% endif %}
    <div class="detail-body">
      {% for para in body | paragraphs %}<p class="lead lead-wide">{{ para }}</p>{% endfor %}
    </div>
    <div class="btn-row">
      <a href="/news/" class="btn btn-outline">All Updates</a>
      <a href="/book/" class="btn btn-primary">Book a Treatment</a>
    </div>
  </div>
</section>
