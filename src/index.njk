---
layout: base.njk
nav: home
eleventyComputed:
  metaTitle: "{{ pages.home.metaTitle }}"
  metaDescription: "{{ pages.home.metaDescription }}"
---
{% set p = pages.home %}

<section class="bg-white">
  <div class="container">
    <div class="grid-2 home-photo-hero" style="align-items:center;">
      <div class="visual-block" style="height:600px;">
        <div class="visual-shape" style="background-image:url('{{ p.heroImage }}'); background-size:cover; background-position:center top;"></div>
      </div>
      <div>
        <p class="eyebrow">{{ p.heroEyebrow }}</p>
        <h1>{{ p.heroTitleA }} <em>{{ p.heroTitleB }}</em></h1>
        <p class="lead">{{ p.heroText }}</p>
        {% for para in p.welcomeBody | paragraphs %}<p class="lead">{{ para }}</p>{% endfor %}
        <div class="btn-row">
          <a href="/book/" class="btn btn-primary">{{ p.heroPrimaryLabel }}</a>
          <a href="/about/" class="btn btn-outline">Read Our Story</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="bg-cream">
  <div class="container">
    <h2>{{ p.treatmentsHeadingA }} <em>{{ p.treatmentsHeadingB }}</em></h2>
    <p class="lead">{{ p.treatmentsIntro }}</p>
    <div class="plain-list mt-3">
      {% for t in collections.treatments %}
      <a href="{{ t.url }}" class="plain-item">
        <h3>{{ t.data.title }}</h3>
        <p>{{ t.data.summary }}</p>
        <span class="plain-link">View treatment &rarr;</span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<section class="bg-white">
  <div class="container">
    <h2>{{ p.supportHeadingA }} <em>{{ p.supportHeadingB }}</em></h2>
    <p class="lead">{{ p.supportIntro }}</p>
    <div class="chip-row mt-3">
      {% for item in pages.treatments.items | limit(5) %}
      <span class="chip chip-accent">{{ item.title }}</span>
      {% endfor %}
    </div>
    <div class="btn-row"><a href="/treatments/#wellbeing" class="btn btn-outline">See the Full List</a></div>
  </div>
</section>

{% if collections.news.length %}
<section class="bg-cream">
  <div class="container">
    <h2>News <em>&amp; updates</em></h2>
    <div class="plain-list mt-3">
      {% for post in collections.news | limit(3) %}
      <a href="{{ post.url }}" class="plain-item plain-item-media">
        <div class="plain-item-text">
          <p class="post-date">{{ post.data.date | niceDate }}</p>
          <h3>{{ post.data.title }}</h3>
          <p>{{ post.data.summary }}</p>
          <span class="plain-link">See more &rarr;</span>
        </div>
        {% if post.data.image %}
        <div class="plain-item-thumb" style="background-image:url('{{ post.data.image }}');"></div>
        {% endif %}
      </a>
      {% endfor %}
    </div>
    <div class="btn-row"><a href="/news/" class="btn btn-outline">All Updates</a></div>
  </div>
</section>
{% endif %}
