<section class="page-hero">
  <div class="orb orb-a"></div><div class="orb orb-b"></div>
  <div class="container">
    <p class="crumb"><a href="/">Home</a> &nbsp;/&nbsp; {{ crumb }}</p>
    <p class="eyebrow">{{ p.heroEyebrow }}</p>
    <h1>{{ p.heroTitleA }}<br /><em style="color:#F7F0E6;">{{ p.heroTitleB }}</em></h1>
    {% if p.heroText %}<p>{{ p.heroText }}</p>{% endif %}
  </div>
</section>
