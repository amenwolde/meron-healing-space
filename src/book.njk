---
layout: base.njk
nav: book
permalink: /book/
hideCta: true
eleventyComputed:
  metaTitle: "{{ pages.book.metaTitle }}"
  metaDescription: "{{ pages.book.metaDescription }}"
---
{% set p = pages.book %}
{% set crumb = "Book" %}
{% include "pagehero.njk" %}

<section class="bg-white">
  <div class="container">
    <div class="grid-4">
      {% for o in p.options %}
      <div class="card book-{{ o.style }}" id="{{ o.id }}">
        <div class="accent"></div>
        <h3>{{ o.title }}</h3>
        <p>{{ o.text }}</p>
        <a href="#booking-form" class="btn book-btn" data-booking-type="{{ o.bookingType }}" onclick="prefillBooking(this)">{{ o.label }}</a>
      </div>
      {% endfor %}
    </div>
  </div>
</section>


<section class="bg-white" id="booking-form">
  <div class="container grid-2" style="align-items:start;">
    <div>
      <p class="eyebrow">{{ p.formEyebrow }}</p>
      <h2>{{ p.formHeadingA }}<br /><em>{{ p.formHeadingB }}</em></h2>
      <p class="lead">{{ p.formIntro }}</p>
      <ul class="info-list">
        <li><span class="ik">Email</span> <a href="mailto:{{ site.email }}" class="info-link">{{ site.email }}</a></li>
        <li><span class="ik">Instagram</span> <a href="{{ site.instagramUrl }}" class="info-link">{{ site.instagram }}</a></li>
        <li><span class="ik">Location</span> {{ site.location }}</li>
        <li><span class="ik">Hours</span> {{ site.hours }}</li>
        <li><span class="ik">Response time</span> {{ site.responseTime }}</li>
      </ul>
      <p class="lead">{{ p.cancellation }}</p>
    </div>

    <form class="form" name="booking" method="POST" data-netlify="true" netlify-honeypot="bot-field">
      <input type="hidden" name="form-name" value="booking">
      <p style="display:none;"><label>Leave blank <input name="bot-field"></label></p>
      <div class="f-group"><label>Name</label><input type="text" name="name" placeholder="Your name" required></div>
      <div class="f-row">
        <div class="f-group"><label>Email</label><input type="email" name="email" placeholder="your@email.com" required></div>
        <div class="f-group"><label>Phone</label><input type="tel" name="phone" placeholder="Optional"></div>
      </div>
      <div class="f-group"><label>What would you like to book?</label>
        <select name="bookingType" id="bookingTypeSelect">
          <option value="">Select&hellip;</option>
          <option>A one-to-one appointment</option>
          <option>A group session</option>
          <option>A package of treatments</option>
          <option>A gift voucher</option>
          <option>A short conversation first</option>
          <option>Just a general question</option>
        </select>
      </div>
      <div class="f-group"><label>Tell Meron a bit about you</label><textarea name="message" placeholder="How does your body feel at the moment? Any preferred days/times? Please also mention any injuries, medication, or if you are pregnant."></textarea></div>
      <button type="submit" class="f-submit">Send Enquiry</button>
      <p class="f-note">Your information is kept confidential and never shared.</p>
    </form>
  </div>
</section>

<section class="bg-cream" id="faq">
  <div class="container-narrow">
    <p class="eyebrow">{{ p.faqEyebrow }}</p>
    <h2>{{ p.faqHeadingA }}<br /><em>{{ p.faqHeadingB }}</em></h2>
    <div class="mt-3">
      {% for f in p.faqs %}
      <div class="faq-item">
        <button class="faq-q">{{ f.q }} <span class="plus">+</span></button>
        <div class="faq-a">{{ f.a }}</div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<script>
function prefillBooking(el){
  var sel = document.getElementById('bookingTypeSelect');
  var val = el.getAttribute('data-booking-type');
  if (sel && val) {
    for (var i = 0; i < sel.options.length; i++) {
      if (sel.options[i].text === val) { sel.selectedIndex = i; break; }
    }
  }
}
</script>
