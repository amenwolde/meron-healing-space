---
layout: base.njk
nav: treatments
---
<section class="page-hero">
  <div class="orb orb-a"></div><div class="orb orb-b"></div>
  <div class="container">
    <p class="crumb"><a href="/">Home</a> &nbsp;/&nbsp; <a href="/treatments/">Treatments</a> &nbsp;/&nbsp; {{ title }}</p>
    <p class="eyebrow">{{ eyebrow }}</p>
    <h1 style="color:#FDFAF6;">{{ title }}</h1>
    <p>{{ summary }}</p>
  </div>
</section>

<section class="bg-white">
  <div class="container detail-grid">
    <div class="detail-body">
      {% if image %}<div class="detail-img" style="background-image:url('{{ image }}');"></div>{% endif %}
      <p class="eyebrow">About This Treatment</p>
      <h2>What to<br /><em>expect</em></h2>
      <div style="margin-top:1.5rem;">
        {% for para in body | paragraphs %}<p>{{ para }}</p>{% endfor %}
      </div>

      {% if suitableFor %}
      <p class="detail-sub">This may suit you if</p>
      <div class="good-for">
        {% for s in suitableFor %}<span class="chip">{{ s }}</span>{% endfor %}
      </div>
      {% endif %}

      {% if includes %}
      <p class="detail-sub">What is included</p>
      <ul class="incl-list">
        {% for i in includes %}<li>{{ i }}</li>{% endfor %}
      </ul>
      {% endif %}

      <p class="detail-sub">Before your session</p>
      <p>Arrive hydrated and avoid a heavy meal in the two hours beforehand. Wear comfortable clothing you can move in. Please let us know about any injuries, medication you are taking, or if you are pregnant, so the session can be adapted.</p>

      <p class="detail-sub">After your session</p>
      <p>Drink plenty of water and keep the rest of your day gentle where you can. You may feel deeply relaxed, or unusually clear and light &mdash; both are normal. You will leave with simple, practical guidance to help you continue caring for your wellbeing at home.</p>
    </div>

    <aside>
      <div class="side-panel">
        <h3>At a Glance</h3>
        {% for g in glance %}
        <div class="sp-row"><span class="sp-key">{{ g.key }}</span><span class="sp-val">{{ g.value }}</span></div>
        {% endfor %}
        {% if noteTitle %}
        <div class="note-box">
          <h4>{{ noteTitle }}</h4>
          <p>{{ noteText }}</p>
        </div>
        {% endif %}
        <a href="/book/" class="btn btn-primary btn-full" style="margin-top:1.6rem;">Book This Treatment</a>
        <a href="/book/#booking-form" class="btn btn-outline btn-full" style="margin-top:0.7rem;">Ask a Question</a>
        <p class="f-note" style="margin-top:1.3rem;">Not sure if this is right for you? Ask us and we will help you choose.</p>
      </div>
    </aside>
  </div>
</section>

<section class="bg-cream">
  <div class="container">
    <p class="eyebrow">You Might Also Consider</p>
    <h2>Other<br /><em>treatments</em></h2>
    <div class="grid-3 mt-3">
      {% for t in collections.treatments %}
        {% if t.data.title != title %}
        <a href="{{ t.url }}" class="card card-link" style="background:var(--white);">
          <div class="accent"></div>
          <h3>{{ t.data.title }}</h3>
          <p>{{ t.data.summary }}</p>
          <span class="card-arrow">View treatment &rarr;</span>
        </a>
        {% endif %}
      {% endfor %}
    </div>
    <div class="btn-row"><a href="/treatments/" class="btn btn-outline">All Treatments</a></div>
  </div>
</section>
